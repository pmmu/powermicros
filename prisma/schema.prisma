generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductKind {
  ONE_TIME
  SUBSCRIPTION
}

enum SubscriptionInterval {
  WEEK
  MONTH
}

enum FulfillmentMode {
  PICKUP
  LOCAL_DELIVERY
  SHIPPING_TEST
}

model Product {
  id                     String                @id
  name                   String
  description            String
  priceCents             Int
  kind                   ProductKind
  subscriptionInterval   SubscriptionInterval?
  leadTimeDays           Int                   @default(0)
  cutoffNote             String                @default("Order by Friday for next week’s harvest.")
  isAvailable            Boolean               @default(true)
  isFeatured             Boolean               @default(false)
  stockQuantity          Int?
  weeklyCapacity         Int?
  fulfillmentMode        FulfillmentMode        @default(PICKUP)
  imageUrl               String?
  imageS3Key             String?
  stripeProductId        String?
  stripePriceId          String?
  stripePriceAmountCents Int?
  sortOrder              Int                   @default(0)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([kind, isAvailable, sortOrder])
}

model OrderSnapshot {
  id                      String   @id
  stripeCheckoutSessionId String   @unique
  stripeCustomerId        String?
  customerEmail           String?
  status                  String
  fulfillmentLocation     String?
  lineItems               Json
  metadata                Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model SubscriptionSnapshot {
  id                   String   @id
  stripeSubscriptionId String   @unique
  stripeCustomerId     String?
  customerEmail        String?
  status               String
  productId            String?
  quantity             Int      @default(1)
  fulfillmentLocation  String?
  metadata             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model CustomGrowRequest {
  id                  String   @id @default(cuid())
  name                String
  contact             String
  requesterType       String
  growType            String
  growTypeLabel       String
  frequency           String
  fulfillmentLocation String
  notes               String?
  selectedSlots       Json
  serviceAreaLabel    String
  status              String   @default("NEW")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status, createdAt])
  @@index([growType, createdAt])
}

model StripeWebhookEvent {
  id            String   @id
  type          String
  processedAt   DateTime @default(now())
  payloadSummary Json?
}
